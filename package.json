{
  "name": "coding-test-web",
  "private": true,
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "docker compose -f server/docker-compose.yml up --build",
    "dev": "concurrently -k -n server,client \"npm run dev:server\" \"npm run dev:client\"",
    "stop": "docker compose -f server/docker-compose.yml down"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
