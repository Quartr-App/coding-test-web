{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".direnv"
  ],
  "paths": {
    "@app/*": [
      "./app/*"
    ],
    "@hooks/*": [
      "./hooks/*"
    ],
    "@utils/*": [
      "./utils/*"
    ],
    "@pages/*": [
      "./pages/*"
    ],
    "@mocks/*": [
      "./mocks/*"
    ],
    "@types/*": [
      "./types/*"
    ]
  }
}